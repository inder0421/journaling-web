# Supabase credentials enable real cross-device sync.
# Copy this file to ".env.local" and fill in the two values below.
#
# Where to find them:
#   Supabase dashboard -> your project -> Project Settings -> API
#   - "Project URL"            -> VITE_SUPABASE_URL
#   - "anon" / "public" key    -> VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to ship in a browser bundle: row-level security
# (see supabase/schema.sql) ensures each user can only read/write their own rows.
#
# If these are left blank the app still runs, but in LOCAL-ONLY mode
# (data stays in this browser, no sync).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
