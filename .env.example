# Supabase credentials enable real cross-device sync.
# Copy this file to ".env.local" and fill in the two values below.
#
# Where to find them:
#   Supabase dashboard -> your project -> Project Settings -> API
#   - "Project URL"            -> VITE_SUPABASE_URL
#   - "anon" / "public" key    -> VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to ship in a browser bundle: row-level security
# (see supabase/schema.sql) ensures each user can only read/write their own rows.
#
# If these are left blank the app still runs, but in LOCAL-ONLY mode
# (data stays in this browser, no sync).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# News Intelligence Engine (News tab) — all optional, all free-tier.
# Leave any of these blank and that source is simply skipped (see the
# "Data sources" panel on the News tab for live/not-configured/error status).
# SEC EDGAR, the Federal Reserve, BLS, and BEA feeds need no key at all.
# ---------------------------------------------------------------------------

# https://finnhub.io/register — free tier covers market + company news.
VITE_FINNHUB_API_KEY=

# https://site.financialmodelingprep.com/developer/docs — free tier covers
# stock news, press releases, and the economic calendar (incl. FOMC dates).
VITE_FMP_API_KEY=

# https://www.alphavantage.co/support/#api-key — free tier covers
# NEWS_SENTIMENT (ships its own bullish/bearish scoring, used when present).
VITE_ALPHA_VANTAGE_API_KEY=

# Public CORS proxy used only for feeds with no CORS headers of their own
# (Fed/BLS/BEA/Yahoo Finance RSS). Override if you run your own proxy.
VITE_NEWS_CORS_PROXY=
