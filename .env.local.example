# Supabase — real cross-device sync.
# Copy this file to `.env.local` and fill in the two values from your
# Supabase project: Project Settings -> Data API / API Keys.
#
# If these are left blank, the app automatically falls back to local-only
# storage (localStorage) so it still works offline / before setup. Real
# sync is the default working path once these are set.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
